{
  "name": "@spcki/server",
  "version": "0.1.0",
  "private": true,
  "description": "SPCKI Platform – Express/Node backend",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file=../.env src/server.js",
    "start": "node --env-file=../.env src/server.js",
    "migrate": "node --env-file=../.env src/db/migrate.js",
    "migrate:dry": "node --env-file=../.env src/db/migrate.js --dry-run",
    "seed": "node --env-file=../.env src/db/seed.js",
    "seed:demo": "node --env-file=../.env src/db/seed.js --demo",
    "db:setup": "npm run migrate && npm run seed:demo",
    "lint": "eslint src tests --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "jose": "^5.10.0",
    "node-cron": "^4.6.0",
    "pg": "^8.14.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.24.0",
    "eslint-plugin-security": "^3.0.1",
    "prettier": "^3.5.3",
    "supertest": "^7.1.0",
    "vitest": "^5.0.3"
  }
}
