{
  "name": "spcki",
  "version": "0.1.0",
  "private": true,
  "description": "SPCKI Digital Monitoring Platform – PERN Stack",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "lint": "npm run lint --workspace=server && npm run lint --workspace=client",
    "test": "npm run test --workspace=server && npm run test --workspace=client",
    "audit:check": "npm audit --audit-level=high",
    "prepare": "husky"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "server/**/*.{js,jsx}": [
      "eslint -c server/eslint.config.js --fix",
      "prettier --write"
    ],
    "client/**/*.{js,jsx}": [
      "eslint -c client/eslint.config.js --fix",
      "prettier --write"
    ],
    "**/*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
