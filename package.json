{
  "name": "spcki-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Solar Powered Communal Kitchen Initiative (SPCKI) – Separated Multi-Stack Workspace",
  "scripts": {
    "dev": "npm run dev --prefix pern",
    "dev:server": "npm run dev:server --prefix pern",
    "dev:client": "npm run dev:client --prefix pern",
    "build": "npm run build --prefix pern",
    "lint": "npm run lint --prefix pern",
    "test": "npm run test --prefix pern",
    "audit:check": "npm run audit:check --prefix pern",
    "pern:dev": "npm run dev --prefix pern",
    "pern:server": "npm run dev:server --prefix pern",
    "pern:client": "npm run dev:client --prefix pern",
    "pern:build": "npm run build --prefix pern",
    "pern:test": "npm run test --prefix pern",
    "pern:lint": "npm run lint --prefix pern",
    "prepare": "husky"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "pern/server/**/*.{js,jsx}": [
      "eslint -c pern/server/eslint.config.js --fix",
      "prettier --write"
    ],
    "pern/client/**/*.{js,jsx}": [
      "eslint -c pern/client/eslint.config.js --fix",
      "prettier --write"
    ],
    "**/*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
